# ===== LLM（OpenAI 兼容：DeepSeek / Moonshot / Qwen / OpenAI / Ollama 都行）=====
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=400

# 留空 API_KEY 会自动进入离线 mock 模式：可以跑通全链路，但不能验收语义
# 本地模型示例：
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# ===== 语音识别 =====
ASR_MODEL=small          # tiny / base / small / medium，CPU 上 small 是速度和准确率的平衡点
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=zh

# huggingface.co 不通时走镜像（国内网络一般需要）
HF_ENDPOINT=https://hf-mirror.com

# ===== 语音合成 =====
TTS_ENGINE=edge_tts      # edge_tts / silent
TTS_DEFAULT_EMOTION=base

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000