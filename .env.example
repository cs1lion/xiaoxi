# ===== LLM（OpenAI 兼容）=====
# Step Plan 专用通道。普通按量付费的 key 要把这段换成 https://api.stepfun.com/v1
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.stepfun.com/step_plan/v1
LLM_API_KEY=
# 对话模型。step-3.7-flash 实测 0/3 编造共同经历；
# stepaudio-2.5-chat 语气更活，但会无视"你没有相关记忆"的提示去编背景故事。
# 性格靠下面的 TTS instruction 传递，不靠对话模型。
LLM_MODEL=step-3.7-flash
# 记忆抽取单独一个模型，在后台跑，慢不影响交互
LLM_EXTRACT_MODEL=step-3.7-flash
LLM_REASONING_EFFORT=low
LLM_EXTRACT_EFFORT=low

# 评测裁判（evals 的 judge 型 check）。必须与被测模型不同厂商，否则自我偏好
# 偏差会让"我没编造"这类判定偏袒自家措辞。留空 = 不启用：judge 一律记 review
# （不算通过也不算失败，交人工复核），不会把无 Key 的跑态假装成判过。
LLM_JUDGE_PROVIDER=
LLM_JUDGE_BASE_URL=
LLM_JUDGE_API_KEY=
LLM_JUDGE_MODEL=
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=400
# 对话用的 token 预算。和"回复该多短"是两件事：
# 太小会在输出中途被截断，留下半个字符或空正文。900 在实测中仍会被
# 推理过程占满；1200 起更稳。
LLM_REPLY_TOKENS=1200
# 重复抑制：抑制"每次都用同一个开头/同一批词"。
# 默认 0 = 不下发该字段。个别 OpenAI 兼容网关遇到未知字段会直接 400，
# 所以确认你的网关支持后再开。对话场景建议 0.2 / 0.2，再高会不敢复用正常词。
LLM_FREQUENCY_PENALTY=0
LLM_PRESENCE_PENALTY=0

# 本地模型示例：
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# ===== 慢环执行内核（pi-durable sidecar）=====
# 1 = 启动 Node sidecar（独占 data/durable/agent.sqlite）。默认关闭是为了让
# 测试和日常启动不反复拉 Node；要跑长任务/崩溃续跑时再点亮。
XIAOXI_DURABLE_ENABLED=
# 逗号分隔：把这些 Worker 的 adapter 在运行时切到 durable（不改 YAML）。
# 留空 = 用花名册的 switch_agents（默认 [scribe]）；填 none = 一个都不切。
# 代码类 Worker 仍建议保留 cli_subproc；文档/整理类可以先切，例如 scribe。
XIAOXI_DURABLE_SWITCH_AGENTS=
# 产品技能目录（Agent Skills 布局）与 MCP server 配置；默认取 config/ 下。
# XIAOXI_SKILLS_DIR=config/skills
# XIAOXI_MCP_CONFIG=config/mcp.json
# C2 编排者 lease 模式：dry_run（默认，只预览）/confirm（要求人工确认）/
# auto（lease 额度内自动派单）。首期只允许 scribe。
XIAOXI_DURABLE_LEASE_MODE=dry_run
# 真实模型窗口与答案预算。compaction 的 reserve/keep 由 sidecar 推导。
# XIAOXI_CONTEXT_WINDOW=32768
# XIAOXI_MAX_TOKENS=8000
# 宿主只读接口地址；一般不用填，app 会按 HOST/PORT 自动注入。
# XIAOXI_HOST_URL=http://127.0.0.1:8000

# ===== 语音合成 =====
# stepaudio 的 instruction 是自然语言情绪描述，音色固定、情绪靠指令变化。
# 换回 edge_tts 就只读 persona.yaml 里的 rate/pitch，忽略 instruction。
TTS_ENGINE=stepaudio
TTS_MODEL=stepaudio-2.5-tts
TTS_VOICE=livelybreezy-female
TTS_FORMAT=mp3
TTS_SAMPLE_RATE=24000
# 修剪供应商在每个音频块前后垫的约 0.36s / 0.38s 静音。打开时按 WAV 取流并修剪，
# 让 pacing.yaml 里设计的呼吸停顿成为真实停顿（不修剪时两者叠加，句间空隙约 1 秒）。
# 浏览器 decodeAudioData 按容器嗅探，交付 WAV 不影响播放。
TTS_TRIM_SILENCE=true
TTS_TRIM_THRESHOLD=0.012
TTS_TRIM_PAD_MS=60

# ===== 语音识别 =====
# stepaudio: HTTP+SSE，约 0.9s 转写 3.4s 音频
# whisper:  本地，需要下载模型，CPU 上慢一个量级
ASR_ENGINE=stepaudio
ASR_MODEL_ID=stepaudio-2.5-asr
ASR_LANGUAGE=zh
# 换回本地识别时打开下面两行
# ASR_ENGINE=whisper
# ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# huggingface.co 不通时走镜像（本地 ASR 才需要）
HF_ENDPOINT=https://hf-mirror.com

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000