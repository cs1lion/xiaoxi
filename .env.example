# ===== LLM（OpenAI 兼容）=====
# Step Plan 专用通道。普通按量付费的 key 要把这段换成 https://api.stepfun.com/v1
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.stepfun.com/step_plan/v1
LLM_API_KEY=
# 对话模型。step-3.7-flash 实测 0/3 编造共同经历；
# stepaudio-2.5-chat 语气更活，但会无视"你没有相关记忆"的提示去编背景故事。
# 性格靠下面的 TTS instruction 传递，不靠对话模型。
LLM_MODEL=step-3.7-flash
# 记忆抽取单独一个模型，在后台跑，慢不影响交互
LLM_EXTRACT_MODEL=step-3.7-flash
LLM_REASONING_EFFORT=low
LLM_EXTRACT_EFFORT=low
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=400
# 对话用的 token 预算。和"回复该多短"是两件事：
# 太小会在输出中途被截断，留下半个字符或空正文。900 在实测中仍会被
# 推理过程占满；1200 起更稳。
LLM_REPLY_TOKENS=1200
# 重复抑制：抑制"每次都用同一个开头/同一批词"。
# 默认 0 = 不下发该字段。个别 OpenAI 兼容网关遇到未知字段会直接 400，
# 所以确认你的网关支持后再开。对话场景建议 0.2 / 0.2，再高会不敢复用正常词。
LLM_FREQUENCY_PENALTY=0
LLM_PRESENCE_PENALTY=0

# 本地模型示例：
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# ===== 语音合成 =====
# stepaudio 的 instruction 是自然语言情绪描述，音色固定、情绪靠指令变化。
# 换回 edge_tts 就只读 persona.yaml 里的 rate/pitch，忽略 instruction。
TTS_ENGINE=stepaudio
TTS_MODEL=stepaudio-2.5-tts
TTS_VOICE=livelybreezy-female
TTS_FORMAT=mp3
TTS_SAMPLE_RATE=24000

# ===== 语音识别 =====
# stepaudio: HTTP+SSE，约 0.9s 转写 3.4s 音频
# whisper:  本地，需要下载模型，CPU 上慢一个量级
ASR_ENGINE=stepaudio
ASR_MODEL_ID=stepaudio-2.5-asr
ASR_LANGUAGE=zh
# 换回本地识别时打开下面两行
# ASR_ENGINE=whisper
# ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# huggingface.co 不通时走镜像（本地 ASR 才需要）
HF_ENDPOINT=https://hf-mirror.com

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000